&meshpara
    nghst = 12
    bdry_cdt = 2
    ncomp = 2
    compfrac = 0
    distribution = 'Janus' !'Janus, Random are the options'
/

&mcpara
    mcalgo = 'mpolis'
    dfac = 8
    kbt = 0.01
    is_restart = .false.
    tot_mc_iter = 20000
    dump_skip = 1000
    is_fluid = .false.
    min_allowed_nbr = 4
    fac_len_vertices = 1.3
    fluidize_every = 1
    iexch=.false.
    nexch_iter=0
/

&bendpara
    bend1 = 5
    bend2 = 5
    spc1 = 0.0
    spc2 = 0.0
    igauss = .true.
/

&stretchpara
    yy1 = 0.3125
    yy2 = 0.3125
    initial_l0="avg"    !avg, spherical are the options right now
    do_volume = .true.
    is_pressurized = .false.
    do_area = .false.
    coef_vol_expansion = 0
    pressure = 0
    coef_area_expansion = 0
/

&electrostatpara
    charge1 = 0
    charge2 = 0
    conc = 0
/

&lipidpara
    iregsoln = 0
    kai = 0
    epssqby2 = 0
/

&selfavoidpara
    isselfrepulsive = .true.
    cutoff = 0.5
    minL = -1.0
    sig = 0.05
    eps = 2.0
/
