&meshpara
    nghst = 12
    bdry_cdt = 2
    ncomp = 2
    compfrac = 0.5
    distribution = 'Random' !'Janus, Random are the options'
/

&mcpara
    mcalgo = 'mpolis'
    dfac = 4
    kbt = 0.1
    is_restart = .false.
    tot_mc_iter = 10000
    dump_skip = 1000
    is_fluid = .false.
    min_allowed_nbr = 4
    fac_len_vertices = 1.3
    fluidize_every = 1
/

&bendpara
    bend1 = 5
    bend2 = 5
    spc1 = 0.0
    spc2 = 0.0
    igauss = .true.
/

&stretchpara
    yy1 = 0.3125
    yy2 = 0.3125
    do_volume = .false.
    is_pressurized = .false.
    do_area = .false.
    coef_vol_expansion = 0
    pressure = 0
    coef_area_expansion = 0
/

&electrostatpara
    charge1 = 0
    charge2 = 0
    conc = 0
/

&lipidpara
    iregsoln = 0
    kai = 0
    epssqby2 = 0
/

&selfavoidpara
    isselfrepulsive = .false.
    boxsize = 0.0
    cutoff = 0.0
    minl = 0.0
    sig = 0.0
    eps = 0.0
/
