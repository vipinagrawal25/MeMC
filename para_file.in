&meshpara
    nghst = 12
    bdry_cdt = 2
    ncomp = 1
    compfrac = 0
    distribution = 'Random' !'Janus, Random are the options'
/

&mcpara
    mcalgo = 'mpolis'
    dfac = 8
    kbt = 0.1
    is_restart = .false.
    tot_mc_iter = 20000
    dump_skip = 10000
    is_fluid = .false.
    min_allowed_nbr = 0
    fac_len_vertices = 0
    fluidize_every = 0
    iexch=.false.
    nexch_iter=0
/

&bendpara
    bend1 = 0.25
    bend2 = 0.25
    spc1 = 0.0
    spc2 = 0.0
    igauss = .false.
/

&stretchpara
    yy1 = 20
    yy2 = 20
    initial_l0="avg"    !avg, spherical are the options right now
    do_volume = .false.
    is_pressurized = .false.
    do_area = .false.
    coef_vol_expansion = 0
    pressure = 0
    coef_area_expansion = 0
/

&electrostatpara
    charge1 = 0
    charge2 = 0
    conc = 0
/

&lipidpara
    iregsoln = 0
    kai = 0
    epssqby2 = 0
/

&selfavoidpara
    isselfrepulsive = .false.
    cutoff = 0
    minL = 0.0
    sig = 0.00
    eps = 0.0
/

&linetensionpara
    lambda=0
/
