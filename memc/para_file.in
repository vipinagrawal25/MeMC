! Self-repulsion via cell-linked list (for folded membranes)
&Celllist
isselfrepulsive = F
boxsize = 10.0
cutoff = 1.5
minL = 0.0
sig = 1.0
eps = 0.0
/

! Mesh and geometry
&Meshpara
N = 2048
nghst = 12
bdry_cdt = 1        ! 0=channel  1=frame (flat)  other=periodic
radius = 1.0        ! set to 1.0 for flat membranes
/

! Bending rigidity
&Bendpara
coef_bend = 4.0
minC = 0.0          ! min spontaneous curvature
maxC = 0.0          ! max spontaneous curvature
theta = 0.0         ! angular threshold for attractive region
spcurv = 0.0        ! spontaneous curvature
/

!Boundary parameters
&Bdrypara
coef_gc = -2.0
do_bdry = F         ! T for stress-free boundary
fix_bottom = F
fix_top = F
fix_left = F
fix_right = F
/


! Wall sticking potential (LJ)
&StickPara
pos_bot_wall = -1.0
sigma = 1.0
eps1 = 0.0          ! repulsive LJ coefficient
eps2 = 0.0          ! attractive LJ coefficient
/

! Monte Carlo parameters
&mcpara
Mcalgo = 'mpolis'   ! mpolis = Metropolis, glauber = Glauber
dfac = 16.0         ! step-size divisor (larger = smaller steps)
kbt = 1.0
is_restart = F
tot_mc_iter = 50000
dump_skip = 1000
is_fluid = F        ! enable bond-flip moves
is_semisolid = F    ! enable semisolid mode (requires solid_index.h5)
num_solid_points = 0
min_allowed_nbr = 4 ! minimum neighbours before bond flip is rejected
fac_len_vertices = 1.3
fluidize_every = 10 ! bond-flip sweep every N iterations
/

! Shear deformation (affine shear applied at initialisation)
&shearpara
do_shear = F
slope = 0.0         ! shear strain gamma (dx per unit y)
constant = 0.0      ! frame spring constant (unused in set-and-run mode)
shear_every = 0
/

! Activity (motility)
&Actpara
act_which = 'none'  ! none, random, constant
doactivity = F
maxA = 0.0
minA = 0.0
/

! Stretching, volume, and pressure
&Stretchpara
YY = 1e4                    ! 2D Young's modulus
do_volume = F               ! enable volume constraint
is_pressurized = F          ! use pressure ensemble (overrides do_volume spring)
is_pressure_ideal = F       ! use ideal gas pressure model
coef_vol_expansion = 0.0   ! volume spring constant (used when is_pressurized=F)
pext = 0.0                  ! external pressure
pint = 0.0                  ! internal pressure
coef_area_expansion = 0.0
do_area = F
/
