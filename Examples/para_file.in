&meshpara
    comp2_frac = 0.5
    distribution = 'Random' !'Janus, Random are the options'
/

&mcpara
    mcalgo = 'mpolis'
    dfac = 64
    kbt = 0.1
    is_restart = .false.
    tot_mc_iter = 5001
    dump_skip = 1000
    is_fluid = .false.
    min_allowed_nbr = 4
    fac_len_vertices = 1.3
    fluidize_every = 1
    iexch=.true.
    nexch_iter=1
/

&bendpara
    bend1 = 250
    bend2 = 250
    spc1 = 0.0
    spc2 = 0.0
    igauss = .true.
/

&stretchpara
    yy1 = 20
    yy2 = 20
    initial_l0="avg"    !avg, spherical are the options right now
    do_volume = .false.
    is_pressurized = .false.
    do_area = .false.
    coef_vol_expansion = 0
    pressure = 0
    coef_area_expansion = 0
/

&electrostatpara
    charge1 = 0
    charge2 = 1
    conc = 0.5
/

&lipidpara
    iregsoln = 0
    kai = 0
    epssqby2 = 0
/

&selfavoidpara
    isselfrepulsive = .false.
    cutoff = 0
    minL = 0.0
    sig = 0.00
    eps = 0.0
/

&linetensionpara
    lambda=0
/
